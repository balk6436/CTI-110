# Ask how many scores the user wants to enter
num_scores = int(input("How many scores do you want to enter? "))

scores = []

# Collect and validate scores
for i in range(num_scores):
    score = float(input(f"\nEnter score #{i + 1}: "))

    while score < 0 or score > 100:
        print("\nINVALID Score entered!!!!")
        print("Score should be between 0 and 100")
        score = float(input(f"Enter score #{i + 1} again: "))

    scores.append(score)

# Find lowest score
lowest_score = min(scores)

# Remove lowest score from a copy of the list
modified_scores = scores.copy()
modified_scores.remove(lowest_score)

# Calculate average
average = sum(modified_scores) / len(modified_scores)

# Determine letter grade
if average >= 90:
    grade = "A"
elif average >= 80:
    grade = "B"
elif average >= 70:
    grade = "C"
elif average >= 60:
    grade = "D"
else:
    grade = "F"

# Display results
print("\n")
print("---------------Results----------------")
print(f"Lowest Score    : {lowest_score}")
print(f"Modified List   : {modified_scores}")
print(f"Scores Average  : {average:.2f}")
print(f"Grade           : {grade}")
print("---------------------------------------")
